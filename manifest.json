{
  "manifest_version": 3,
  "name": "Website Reader",
  "version": "0.1.0",
  "description": "Collect a publication issue into a single Markdown file.",
  "permissions": ["clipboardWrite", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://www.economist.com/*",
    "https://alumni.berkeley.edu/*",
    "https://cacm.acm.org/*",
    "https://www.nytimes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Website Reader",
    "default_popup": "popup.html"
  }
}
