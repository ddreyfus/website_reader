{
  "name": "website-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:extension": "node --test tests/*.test.mjs",
    "mcp:serve": "node scripts/mcp-archive.mjs",
    "mcp:start": "node scripts/mcp-runtime.mjs start",
    "mcp:stop": "node scripts/mcp-runtime.mjs stop",
    "mcp:status": "node scripts/mcp-runtime.mjs status",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "tika:install": "node scripts/install-tika.mjs",
    "bleve:build": "mkdir -p .local-mcp/bin && cd lexical-search && go build -o ../.local-mcp/bin/lexical-search .",
    "bleve:start": ".local-mcp/bin/lexical-search",
    "test:bleve": "cd lexical-search && go test ./..."
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
