{
  "name": "website-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "semantic:deps": "python3 scripts/semantic-search.py install",
    "semantic:build": "python3 scripts/semantic-search.py build",
    "semantic:test": "python3 -B -m unittest discover -s tests -p 'test_semantic_*.py' && python3 scripts/semantic-search.py test",
    "semantic:serve": "python3 scripts/semantic-search.py serve",
    "semantic:install": "python3 scripts/install-launchagent.py ollama",
    "semantic:enable": "python3 scripts/install-launchagent.py bleve --semantic",
    "semantic:pull": "python3 scripts/semantic-search.py pull",
    "test": "node --test tests/*.test.mjs",
    "test:extension": "node --test tests/*.test.mjs",
    "mcp:serve": "node scripts/mcp-archive.mjs",
    "mcp:start": "node scripts/mcp-runtime.mjs start",
    "mcp:stop": "node scripts/mcp-runtime.mjs stop",
    "mcp:status": "node scripts/mcp-runtime.mjs status",
    "mcp:install": "python3 scripts/install-launchagent.py tunnel",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "tika:install": "node scripts/install-tika.mjs",
    "bleve:build": "mkdir -p .local-mcp/bin && cd lexical-search && go build -o ../.local-mcp/bin/lexical-search .",
    "bleve:start": ".local-mcp/bin/lexical-search",
    "bleve:install": "python3 scripts/install-launchagent.py bleve",
    "test:bleve": "cd lexical-search && go test ./..."
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.63.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
