{
  "manifest_version": 3,
  "name": "Website Reader",
  "version": "0.1.0",
  "minimum_chrome_version": "141",
  "description": "Collect publication issues or a Gmail newsletter and its linked articles into Markdown.",
  "permissions": [
    "alarms",
    "clipboardWrite",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.economist.com/*",
    "https://alumni.berkeley.edu/*",
    "https://cacm.acm.org/*",
    "https://www.nytimes.com/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Website Reader"
  },
  "side_panel": { "default_path": "popup.html" },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
